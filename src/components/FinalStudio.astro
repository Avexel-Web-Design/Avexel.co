---
import Icon from './Icon.astro';
import wordmark from '../assets/avexel-wordmark.svg?raw';
interface Project { name: string; type: string; image: string; url: string; description: string; }
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const services = [
  { id: 'design', label: 'Design', title: 'A clear plan for your website.', description: 'We organize your content and design the pages around what your visitors need to do.', includes: ['Page structure & navigation', 'Layouts for every screen', 'Visual design & prototypes'], detail: 'Review and approve the design before we build.' },
  { id: 'development', label: 'Development', title: 'From approved design to live site.', description: 'We build websites and web applications with the features your business actually needs.', includes: ['Custom websites & applications', 'Forms, booking & online stores', 'Integrations, testing & launch'], detail: 'Built for phones, tablets, and desktops.' },
  { id: 'maintenance', label: 'Maintenance', title: 'Keep your website working for you.', description: 'We look after existing websites, whether we built them or you’re bringing one to us.', includes: ['Content & layout updates', 'Bug fixes & troubleshooting', 'New features & integrations'], detail: 'Agree on the changes and cost before work begins.' },
];
const inquiries = ['New website', 'Web application', 'Website redesign', 'Maintenance & updates', 'Something else'];
---

<div class="real-site studio-shell">
  <div class="content-workspace" data-content-view="home" data-transitioning="false">
    <section class="identity-tile" data-panel="home" data-layout-piece aria-labelledby="home-title">
      <h2 id="home-title"><button type="button" class="identity-wordmark" data-view="home" aria-label="Avexel home"><img src="/Logo-studio.png" width="500" height="500" alt="" /><span aria-hidden="true" set:html={wordmark} /></button></h2>
      <div class="identity-description"><p>Web design, development<br />& maintenance.</p><p>Work directly with the people<br />building your website.</p></div>
    </section>

    <section class="content-tile services-tile" data-panel="services" data-layout-piece aria-labelledby="services-title">
      <div class="tile-material glass-surface" aria-hidden="true"></div>
      <div class="tile-inner"><header class="tile-heading"><h2 id="services-title"><button type="button" data-view="services"><span class="tile-label">Services</span><Icon name="arrowUpRight" /></button></h2><button class="tile-close" type="button" data-view="home" aria-label="Close Services and return home" disabled aria-hidden="true"><Icon name="plus" /></button></header>
        <div class="service-tabs" role="tablist" aria-label="Services">{services.map((service, index) => <button type="button" role="tab" id={`service-tab-${service.id}`} aria-controls={`service-${service.id}`} aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} data-service-tab={service.id}><span class="service-label">{service.label}</span><span class="service-active-rule" aria-hidden="true"></span></button>)}</div>
        <div class="tile-detail" data-tile-detail hidden>
        {services.map((service, index) => <article class="service-content" role="tabpanel" id={`service-${service.id}`} aria-labelledby={`service-tab-${service.id}`} data-service-panel={service.id} hidden={index !== 0}><div class="service-overview"><h3>{service.title}</h3><p>{service.description}</p><p class="service-detail">{service.detail}</p></div><ul class="service-includes" aria-label="What we do">{service.includes.map(item => <li>{item}</li>)}</ul></article>)}
        <div class="service-terms"><div><h3>Clear scope. Upfront quote.</h3><p>Hosting, domains, and third-party fees are separate.</p></div><div><h3>Your website stays yours.</h3><p>You own the code and content. Choose your hosting and maintenance.</p></div></div>
        </div></div>
    </section>

    <section class="content-tile studio-tile" data-panel="studio" data-layout-piece aria-labelledby="studio-title">
      <div class="tile-material glass-surface" aria-hidden="true"></div>
      <div class="tile-inner"><header class="tile-heading"><h2 id="studio-title"><button type="button" data-view="studio"><span class="tile-label">Studio</span><Icon name="arrowUpRight" /></button></h2><button class="tile-close" type="button" data-view="home" aria-label="Close Studio and return home" disabled aria-hidden="true"><Icon name="plus" /></button></header>
        <div class="studio-preview"><p class="studio-introduction"><strong>Student-led studio<span class="stop">.</span><span class="comma">,</span></strong><span class="locale">Based in Harbor Springs.</span></p></div>
        <div class="tile-detail" data-tile-detail hidden>
        <p class="studio-summary">A four-person, student-led team.</p>
        <div class="studio-people"><div><h3>Ryan Latimer</h3><p class="person-role">Operations & development</p><p class="person-background"><span class="bg-full">Harbor Springs High School junior · Captain & programming lead, Baywatch Robotics</span><span class="bg-short">Harbor Springs junior · Baywatch captain</span></p></div><div><h3>Gavin Moceri</h3><p class="person-role">Development · <a href="https://gavinmoceri.com" target="_blank" rel="noreferrer">Portfolio <Icon name="arrowUpRight" /></a></p><p class="person-background"><span class="bg-full">Michigan Technological University freshman · Former Baywatch captain & design lead</span><span class="bg-short">Michigan Technological University freshman · Former Baywatch captain</span></p></div><div><h3>Conner Breckenfeld</h3><p class="person-role">Client outreach, photography & drone</p><p class="person-background"><span class="bg-full">Northern Michigan University freshman · Former Baywatch assistant captain & build lead</span><span class="bg-short">NMU freshman · Former Baywatch build lead</span></p></div><div><h3>Brooke Winkler</h3><p class="person-role">Client outreach & social · <a href="https://brookewinkler.com" target="_blank" rel="noreferrer">Portfolio <Icon name="arrowUpRight" /></a></p><p class="person-background"><span class="bg-full">Michigan Technological University freshman · Former captain, FRC 7598 SCA Constellations</span><span class="bg-short">Michigan Technological University freshman · Former FRC 7598 captain</span></p></div></div>
        <div class="studio-roots"><p>Our work helps fund our FIRST teams and STEM education.</p><div class="studio-links"><a class="team-link" href="https://frc7790.com" target="_blank" rel="noreferrer"><img src="/baywatchLogo.webp" width="72" height="72" alt="" /><span>Baywatch Robotics</span><Icon name="arrowUpRight" /></a><a class="plain-link" href="/communications/">Client guide <Icon name="arrowUpRight" /></a></div></div>
        </div></div>
    </section>

    <section class="content-tile work-tile" data-panel="work" data-layout-piece aria-labelledby="work-title">
      <div class="tile-material glass-surface" aria-hidden="true"></div>
      <div class="tile-inner"><header class="tile-heading"><h2 id="work-title"><button type="button" data-view="work"><span class="tile-label">Work</span><Icon name="arrowUpRight" /></button></h2><button class="tile-close" type="button" data-view="home" aria-label="Close Work and return home" disabled aria-hidden="true"><Icon name="plus" /></button></header>
        <div class="tile-detail" data-tile-detail hidden>
        <div class="work-choices" role="group" aria-label="Select a project">{projects.map((project, index) => <button type="button" data-select-project={index} aria-pressed={index === 0} aria-label={`Show ${project.name}`}><span>{project.name}</span><span class="project-active-rule" aria-hidden="true"></span></button>)}</div>
        </div>
        <div class="supporting-projects">{projects.map((project, index) => <article data-project={index} hidden={index !== 0}><div class="work-frame"><a class="work-image" href={project.url} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name}`}><img src={`/images/work-${project.image}.webp`} srcset={`/images/work-${project.image}-400.webp 400w, /images/work-${project.image}-800.webp 800w, /images/work-${project.image}.webp ${project.image === 'atlas' || project.image === 'afterimage' ? 1440 : 1200}w`} sizes="(max-width:767px) 85vw, 55vw" alt={`${project.name} website`} width="1440" height="1000" loading="lazy" /><span aria-hidden="true">Visit site <Icon name="arrowUpRight" /></span></a></div><div class="work-description"><h3>{project.name}</h3><p>{project.description}</p></div></article>)}</div>
      </div>
    </section>

    <section class="content-tile contact-tile" data-panel="contact" data-layout-piece aria-labelledby="contact-title">
      <div class="tile-material glass-surface" aria-hidden="true"></div>
      <div class="tile-inner"><header class="tile-heading"><h2 id="contact-title"><button type="button" data-view="contact"><span class="tile-label">Contact</span><Icon name="arrowUpRight" /></button></h2><button class="tile-close" type="button" data-view="home" aria-label="Close Contact and return home" disabled aria-hidden="true"><Icon name="plus" /></button></header>
        <div class="contact-methods"><a href="mailto:contact@avexel.co">contact@avexel.co <Icon name="arrowUpRight" /></a><a href="tel:+12313738360">(231) 373-8360</a></div>
        <div class="tile-detail" data-tile-detail hidden><p class="contact-instructions">Describe what you need and your timeline. If you have an existing site, include the URL.</p>
        <form class="inquiry-form" action="https://formspree.io/f/xvgkwonw" method="POST" data-contact-form>
          <div class="inquiry-pair"><div class="field"><label for="contact-name">Your name</label><input id="contact-name" name="name" autocomplete="name" required maxlength="120" /></div><div class="field"><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div></div>
          <div class="field service-field" data-service-select><label id="contact-service-label" for="contact-service">What can we help with?</label><input type="hidden" name="service" value={inquiries[0]} /><button id="contact-service" class="service-select-trigger" type="button" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="contact-service-options" aria-labelledby="contact-service-label contact-service-value"><span id="contact-service-value">{inquiries[0]}</span><Icon name="caretDown" /></button><div id="contact-service-options" class="service-select-options" role="listbox" aria-labelledby="contact-service-label" hidden>{inquiries.map((inquiry, index) => <button id={`inquiry-option-${index}`} type="button" role="option" aria-selected={index === 0} tabindex="-1" data-service-option={inquiry}>{inquiry}<span aria-hidden="true">✓</span></button>)}</div></div>
          <div class="field"><label for="contact-message">A little about your project</label><textarea id="contact-message" name="message" rows="3" required maxlength="10000"></textarea></div>
          <div class="honeypot" aria-hidden="true"><label for="website-field">Leave this empty</label><input id="website-field" name="_gotcha" tabindex="-1" autocomplete="off" /></div><input type="hidden" name="_subject" value="New project inquiry from Avexel" />
          <button type="submit" class="inquiry-submit">Send message <Icon name="arrowUpRight" /></button><p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
        </form>
        </div></div>
    </section>
  </div>

  <footer class="studio-footer"><span>Harbor Springs, Michigan</span><button type="button" data-replay>Replay the teardown <span>↺</span></button><span>© {new Date().getFullYear()} Avexel</span></footer>
</div>
