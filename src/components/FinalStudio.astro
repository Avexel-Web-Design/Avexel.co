---
import Icon from './Icon.astro';
import wordmark from '../assets/avexel-wordmark.svg?raw';
import ThemeToggle from './ThemeToggle.astro';
interface Project { name: string; type: string; image: string; url: string; description: string; }
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const services = [
  { id: 'websites', label: 'Websites', description: 'Business sites, portfolios, online stores, and redesigns.' },
  { id: 'web-apps', label: 'Web apps', description: 'Browser-based tools, dashboards, and custom backend systems.' },
  { id: 'mobile-apps', label: 'Mobile apps', description: 'Applications for iOS and Android.' },
];
const inquiries = ['Website', 'Web application', 'Mobile app', 'Updates & fixes', 'Something else'];
---

<div class="real-site studio-shell">
  <div class="content-workspace" data-content-view="home" data-transitioning="false">
    <ThemeToggle />
    <section class="identity-tile" data-panel="home" data-layout-piece aria-labelledby="home-title">
      <h2 id="home-title"><button type="button" class="identity-wordmark" data-view="home" aria-label="Avexel home"><img src="/images/avexel-mark.webp" width="404" height="430" alt="" /><span aria-hidden="true" set:html={wordmark} /></button></h2>
    </section>

    <section class="content-tile services-tile" data-panel="services" data-layout-piece aria-labelledby="services-title">
      <div class="tile-material glass-surface" aria-hidden="true"></div>
      <div class="tile-inner"><header class="tile-heading"><h2 id="services-title"><button type="button" data-view="services"><span class="tile-label">Services</span><Icon name="arrowUpRight" /></button></h2><button class="tile-close" type="button" data-view="home" aria-label="Close Services and return home" disabled aria-hidden="true"><Icon name="plus" /></button></header>
        <p class="services-intro">We handle the design and development.</p>
        <dl class="service-offerings">{services.map(service => <div data-service-offering={service.id}><dt><span class="service-label">{service.label}</span></dt><dd>{service.description}</dd></div>)}</dl>
        <div class="tile-detail" data-tile-detail hidden><p class="services-support">We also fix, update, and extend existing projects.</p></div>
      </div>
    </section>

    <section class="content-tile studio-tile" data-panel="studio" data-layout-piece aria-labelledby="studio-title">
      <div class="tile-material glass-surface" aria-hidden="true"></div>
      <div class="tile-inner"><header class="tile-heading"><h2 id="studio-title"><button type="button" data-view="studio"><span class="tile-label">Team</span><Icon name="arrowUpRight" /></button></h2><button class="tile-close" type="button" data-view="home" aria-label="Close Team and return home" disabled aria-hidden="true"><Icon name="plus" /></button></header>
        <div class="studio-preview"><p class="studio-introduction"><strong>Student-led team,</strong> <span class="locale">based in Harbor Springs.</span></p></div>
        <div class="tile-detail" data-tile-detail hidden>
        <div class="studio-people"><div><h3>Ryan Latimer</h3><p class="person-role">Operations & development</p><p class="person-background"><span class="bg-full">Harbor Springs High School junior · Captain & programming lead, Baywatch Robotics</span><span class="bg-short">Harbor Springs junior · Baywatch captain</span></p></div><div><h3>Gavin Moceri</h3><p class="person-role">Development · <a href="https://gavinmoceri.com" target="_blank" rel="noreferrer">Portfolio <Icon name="arrowUpRight" /></a></p><p class="person-background"><span class="bg-full">Michigan Technological University freshman · Former Baywatch captain & design lead, now mentor</span><span class="bg-short">Michigan Technological University freshman · Baywatch mentor</span></p></div><div><h3>Conner Breckenfeld</h3><p class="person-role">Client outreach, photography & drone</p><p class="person-background"><span class="bg-full">Northern Michigan University freshman · Former Baywatch assistant captain & build lead, now mentor</span><span class="bg-short">NMU freshman · Baywatch mentor</span></p></div><div><h3>Brooke Winkler</h3><p class="person-role">Client outreach & social · <a href="https://brookewinkler.com" target="_blank" rel="noreferrer">Portfolio <Icon name="arrowUpRight" /></a></p><p class="person-background"><span class="bg-full">Michigan Technological University freshman · Former captain, FRC 7598 SCA Constellations</span><span class="bg-short">Michigan Technological University freshman · Former FRC 7598 captain</span></p></div></div>
        <div class="studio-roots"><p>Our work helps fund Baywatch Robotics and STEM education.</p><div class="studio-links"><a class="team-link" href="https://frc7790.com" target="_blank" rel="noreferrer"><img src="/baywatchLogo.webp" width="72" height="72" alt="" /><span>Baywatch Robotics</span><Icon name="arrowUpRight" /></a><a class="plain-link" href="/communications/">Client guide <Icon name="arrowUpRight" /></a></div></div>
        </div></div>
    </section>

    <section class="content-tile work-tile" data-panel="work" data-layout-piece aria-labelledby="work-title">
      <div class="tile-material glass-surface" aria-hidden="true"></div>
      <div class="tile-inner"><header class="tile-heading"><h2 id="work-title"><button type="button" data-view="work"><span class="tile-label">Work</span><Icon name="arrowUpRight" /></button></h2><button class="tile-close" type="button" data-view="home" aria-label="Close Work and return home" disabled aria-hidden="true"><Icon name="plus" /></button></header>
        <div class="tile-detail" data-tile-detail hidden>
        <div class="work-choices" role="group" aria-label="Select a project">{projects.map((project, index) => <button type="button" data-select-project={index} aria-pressed={index === 0} aria-label={`Show ${project.name}`}><span>{project.name}</span><span class="project-active-rule" aria-hidden="true"></span></button>)}</div>
        </div>
        <div class="supporting-projects">{projects.map((project, index) => { const version = project.image === 'atlas' ? '?v=13cdd7d' : ''; return <article data-project={index} hidden={index !== 0}><div class="work-frame"><a class="work-image" href={project.url} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name}`}><picture>{project.image === 'atlas' && <source data-theme-light-image media="all" srcset="/images/work-atlas-light-400.webp?v=13cdd7d 400w, /images/work-atlas-light-800.webp?v=13cdd7d 800w, /images/work-atlas-light.webp?v=13cdd7d 1440w" sizes="(max-width:767px) 85vw, 55vw" />}<img src={`/images/work-${project.image}.webp${version}`} srcset={`/images/work-${project.image}-400.webp${version} 400w, /images/work-${project.image}-800.webp${version} 800w, /images/work-${project.image}.webp${version} ${project.image === 'atlas' || project.image === 'afterimage' ? 1440 : 1200}w`} sizes="(max-width:767px) 85vw, 55vw" alt={`${project.name} website`} width="1440" height="1000" loading="lazy" /></picture><span aria-hidden="true">Visit site <Icon name="arrowUpRight" /></span></a></div><div class="work-description"><h3>{project.name}</h3><p>{project.description}</p></div></article>; })}</div>
      </div>
    </section>

    <section class="content-tile contact-tile" data-panel="contact" data-layout-piece aria-labelledby="contact-title">
      <div class="tile-material glass-surface" aria-hidden="true"></div>
      <div class="tile-inner"><header class="tile-heading"><h2 id="contact-title"><button type="button" data-view="contact"><span class="tile-label">Contact</span><Icon name="arrowUpRight" /></button></h2><button class="tile-close" type="button" data-view="home" aria-label="Close Contact and return home" disabled aria-hidden="true"><Icon name="plus" /></button></header>
        <div class="contact-methods"><a href="mailto:contact@avexel.co">contact@avexel.co <Icon name="arrowUpRight" /></a><a href="tel:+12313738360">(231) 373-8360</a></div>
        <div class="tile-detail" data-tile-detail hidden><p class="contact-instructions">Describe what you need and your timeline. If you have an existing site, include the URL.</p>
        <form class="inquiry-form" action="https://formspree.io/f/xvgkwonw" method="POST" data-contact-form>
          <div class="inquiry-pair"><div class="field"><label for="contact-name">Your name</label><input id="contact-name" name="name" autocomplete="name" required maxlength="120" /></div><div class="field"><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div></div>
          <div class="field service-field" data-service-select><label id="contact-service-label" for="contact-service">What can we help with?</label><input type="hidden" name="service" value={inquiries[0]} /><button id="contact-service" class="service-select-trigger" type="button" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="contact-service-options" aria-labelledby="contact-service-label contact-service-value"><span id="contact-service-value">{inquiries[0]}</span><Icon name="caretDown" /></button><div id="contact-service-options" class="service-select-options" role="listbox" aria-labelledby="contact-service-label" hidden>{inquiries.map((inquiry, index) => <button id={`inquiry-option-${index}`} type="button" role="option" aria-selected={index === 0} tabindex="-1" data-service-option={inquiry}>{inquiry}<span aria-hidden="true">✓</span></button>)}</div></div>
          <div class="field"><label for="contact-message">A little about your project</label><textarea id="contact-message" name="message" rows="3" required maxlength="10000"></textarea></div>
          <div class="honeypot" aria-hidden="true"><label for="website-field">Leave this empty</label><input id="website-field" name="_gotcha" tabindex="-1" autocomplete="off" /></div><input type="hidden" name="_subject" value="New project inquiry from Avexel" />
          <button type="submit" class="inquiry-submit">Send message <Icon name="arrowUpRight" /></button><p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
        </form>
        </div></div>
    </section>
  </div>

  <footer class="studio-footer"><span>© {new Date().getFullYear()} Avexel</span></footer>
</div>
