---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { features, pageRanges, money } from '../data/pricing';
const categories = [...new Set(features.map(feature => feature.category))];
---
<SiteLayout title="Build an estimate | Avexel" description="Explore website features and build a starting estimate for your project. Custom design and development from Avexel in Harbor Springs, Michigan.">
  <div class="wrap">
    <header class="page-intro"><a class="back-link" href="/#services">← Back to the studio</a><h1>A little clarity.<br />Before we get started.</h1><p>Choose your pages and features for a starting estimate. We’ll work through the details together before agreeing on a final quote.</p></header>
    <noscript><p class="quote-no-js">The interactive estimator needs JavaScript. You can still browse all our features below, or <a href="/#contact">contact us for a quote</a>.</p></noscript>
    <div class="quote-layout" data-estimator>
      <div class="quote-options">
        <div class="field"><label for="page-range">How many pages do you have in mind?</label><select id="page-range" required><option value="">Choose a page range</option>{pageRanges.map(range => <option value={range.value}>{range.label}</option>)}</select></div>
        <h2>Make it your own.</h2>
        {categories.map((category,index) => <details class="quote-group" open={index === 0}><summary>{category}<Icon name="plus" /></summary><div>{features.filter(feature => feature.category === category).map(feature => <label class="quote-feature"><input type="checkbox" value={feature.id} checked={feature.required} disabled={feature.required} /><span class="feature-copy"><strong>{feature.name}</strong><small>{feature.description}</small></span><span class="feature-price">{feature.required ? (feature.price ? money(feature.price) : 'Included') : `+${money(feature.price)}`}</span></label>)}</div></details>)}
      </div>
      <aside class="quote-summary glass" aria-label="Project estimate"><h2>Your starting point.</h2><output class="quote-amount" id="quote-total" aria-live="polite">{money(77.9)}</output><p class="quote-caption" id="quote-caption">Choose a page range to complete your estimate.</p><ul class="quote-includes" id="quote-includes">{features.filter(feature => feature.required).map(feature => <li><Icon name="check" />{feature.name}</li>)}</ul><a class="button" id="share-estimate" href="/#contact">Discuss my project <Icon name="arrowUpRight" /></a><p class="quote-disclaimer">An estimate, not a final price. Feature prices are adjusted for your page count. Domain registration, hosting, payment-provider fees, and other third-party costs are separate.</p><p class="quote-disclaimer">Custom development is a one-time project cost. We’ll discuss any ongoing support before work begins.</p></aside>
    </div>
  </div>
  <script>
    import { calculateEstimate, money } from '../data/pricing';
    const root = document.querySelector<HTMLElement>('[data-estimator]');
    const range = document.querySelector<HTMLSelectElement>('#page-range');
    const total = document.querySelector<HTMLOutputElement>('#quote-total');
    const caption = document.querySelector<HTMLElement>('#quote-caption');
    const list = document.querySelector<HTMLUListElement>('#quote-includes');
    const share = document.querySelector<HTMLAnchorElement>('#share-estimate');
    function selection() { return [...(root?.querySelectorAll<HTMLInputElement>('input[type=checkbox]:checked') ?? [])].map(input => input.value); }
    function update() {
      const commerce = root?.querySelector<HTMLInputElement>('input[value=ecommerce]');
      const payments = root?.querySelector<HTMLInputElement>('input[value=payments]');
      if (commerce?.checked && payments) { payments.checked = true; payments.disabled = true; } else if (payments) payments.disabled = false;
      const estimate = calculateEstimate(selection(), range?.value ?? '');
      if (total) total.textContent = money(estimate.total);
      if (caption) caption.textContent = estimate.range ? `Starting estimate · ${estimate.range.label} · USD` : 'Choose a page range to complete your estimate.';
      if (list) {
        list.replaceChildren(...estimate.selected.map(feature => { const item = document.createElement('li'); item.textContent = `✓ ${feature.name}`; return item; }));
        if (estimate.range) { const item = document.createElement('li'); item.textContent = `✓ ${estimate.range.label}`; list.append(item); }
      }
      if (share) share.textContent = estimate.range ? 'Start a project ↗' : 'Discuss my project ↗';
    }
    root?.addEventListener('change', update);
    share?.addEventListener('click', () => {
      const estimate = calculateEstimate(selection(), range?.value ?? '');
      const summary = `Starting estimate: ${money(estimate.total)} USD\nPages: ${estimate.range?.label ?? 'To be discussed'}\nFeatures: ${estimate.selected.map(feature => feature.name).join(', ')}\nFinal scope and pricing to be confirmed.`;
      try { sessionStorage.setItem('avexel-estimate', summary); } catch { /* Users can describe their project when storage is unavailable. */ }
    });
  </script>
</SiteLayout>
