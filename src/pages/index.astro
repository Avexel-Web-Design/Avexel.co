---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import '../styles/scene.css';

const projects = [
  { name: 'Atlas', type: 'Robotics intelligence', image: 'atlas', url: 'https://atlas.frc7790.com', description: 'Competition data, predictions, and scouting. One place for the decisions that happen before the match.' },
  { name: 'Afterimage', type: 'Multiplayer browser game', image: 'afterimage', url: 'https://afterimage.avexel.workers.dev', description: 'Your past movements become your next opponent. A multiplayer game built to play in your browser.' },
  { name: 'Baywatch Robotics', type: 'Team website', image: 'baywatch', url: 'https://frc7790.com', description: 'A home for the robots, people, and sponsors behind FIRST Robotics Team 7790.' },
  { name: 'Detroit Rising', type: 'Real estate development', image: 'detroit', url: 'https://detroitrisingdevelopment.pages.dev', description: 'A clear view of a development company’s projects, services, and vision for Detroit.' },
];
const annotations = [
  { id: 'brand', target: '.demo-brand > span', text: 'A dot is not a personality.' },
  { id: 'nav', target: '.demo-nav > div', text: 'The same menu on a thousand agency sites.' },
  { id: 'label', target: '.demo-eyebrow', text: 'Two buzzwords. Zero information.' },
  { id: 'title', target: '.demo-copy h1', text: 'Could be literally any agency.' },
  { id: 'description', target: '.demo-description', text: '15 words. Still no idea what you get.' },
  { id: 'button', target: '.demo-copy > .demo-cta', text: 'A slogan where an action should be.' },
  { id: 'art', target: '.plus-one', text: 'A plus sign that adds nothing.' },
  { id: 'caption', target: '.demo-art figcaption', text: 'A caption that tells you nothing about the work.' },
  { id: 'craft', target: '.art-caption', text: 'Tiny type. Another empty claim.' },
  { id: 'bottom', target: '.demo-bottom > span:first-child', text: 'More filler, but make it uppercase.' },
  { id: 'navcta', target: '.demo-nav > .demo-cta', text: 'Two buttons. Same destination. Different slogans.' },
];
---

<SiteLayout immersive title="Avexel | Our work isn't AI slop.">
  <div class="scroll-story" id="home">
    <div class="scene">
      <div class="demo-page" aria-label="An intentionally generic website, used as a design demonstration">
        <header class="demo-nav"><a class="demo-brand" href="#home">avexel<span>.</span></a><div><span>Solutions</span><span>Our process</span><span>Why us</span></div><button type="button" class="demo-cta" data-skip>Let’s innovate <Icon name="arrowUpRight" /></button></header>
        <div class="demo-main">
          <div class="demo-copy"><p class="demo-eyebrow"><i></i> YOUR VISION. OUR INNOVATION.</p><h1>We build digital<br /><span>experiences.</span></h1><p class="demo-description">Empowering ambitious brands with cutting-edge solutions that elevate your digital presence and unlock limitless possibilities.</p><button class="demo-cta" type="button" data-skip>Unlock your potential <Icon name="arrowUpRight" /></button></div>
          <figure class="demo-art"><img src="/images/work-atlas.webp" alt="Atlas web application" width="1440" height="1000" fetchpriority="high" /><span class="art-plus plus-one">+</span><span class="art-plus plus-two">+</span><figcaption>DIGITAL EXCELLENCE / REIMAGINED</figcaption><span class="art-caption">CRAFTED WITH PURPOSE</span></figure>
        </div>
        <div class="demo-bottom"><span><i></i> DESIGN-DRIVEN. FUTURE-READY.</span><span>CREATIVITY MEETS TECHNOLOGY</span><span>SCROLL TO DISCOVER ↓</span></div>
      </div>

      <div class="intervention" aria-hidden="true">
        <div class="statement line-one"><span class="keep-work word-space-after">Our work</span><span class="discard-one">does</span><span class="keep-not">n’t</span><span class="discard-one word-space-before">look like this.</span></div>
        <div class="statement line-two"><span class="discard-two word-space-after">This</span><span class="keep-is word-space-after">is</span><span class="keep-slop">AI slop.</span></div>
      </div>

      <div class="annotations" aria-hidden="true">
        <svg class="annotation-connectors" aria-hidden="true">{annotations.map(note => <g data-connector={note.id}><path /><circle r="3.5" /></g>)}</svg>
        {annotations.map(note => <div class={`annotation note-${note.id}`} data-note={note.id} data-target={note.target}><span>{note.text}</span></div>)}
      </div>

      <canvas class="eraser-canvas" aria-hidden="true"></canvas>

      <div class="real-site">
        <header class="real-header"><a href="#home" class="real-wordmark" data-replay aria-label="Avexel, replay introduction">avexel</a><nav aria-label="Main navigation"><button type="button" data-view="work" aria-pressed="true">Work <span>04</span></button><button type="button" data-view="studio" aria-pressed="false">Studio</button><button type="button" data-view="contact" aria-pressed="false">Start a project <Icon name="arrowUpRight" /></button></nav></header>

        <section class="canvas-view work-view" data-panel="work" aria-label="Selected work">
          <div class="work-intro"><h2>Made with<br /><span>a point of view.</span></h2><p>Independent web design & development.<br />Harbor Springs, Michigan. Anywhere online.</p></div>
          <div class="project-stage">
            {projects.map((project, i) => <article class:list={['project-slide', { 'is-active': i === 0 }]} data-project={i} hidden={i !== 0}>
              <a class="project-screen" href={project.url} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name}`}><img src={`/images/work-${project.image}.webp`} alt={`${project.name} website`} width="1440" height="1000" loading={i === 0 ? 'eager' : 'lazy'} /><span class="visit-project">Visit site <Icon name="arrowUpRight" /></span></a>
              <div class="project-caption"><h3>{project.name}</h3><p>{project.type}</p><span>0{i + 1} / 04</span></div>
            </article>)}
          </div>
          <div class="project-selector" role="group" aria-label="Select a project">{projects.map((project, i) => <button type="button" data-select-project={i} aria-pressed={i === 0}><span>0{i + 1}</span>{project.name}<Icon name="arrowUpRight" /></button>)}</div>
          <div class="work-foot"><p>Websites. Applications. Nothing off the shelf.</p></div>
        </section>

        <section class="canvas-view studio-view" data-panel="studio" hidden aria-labelledby="studio-title">
          <div class="studio-heading"><h2 id="studio-title">Small team.<br />Real people.<br /><span>Our own code.</span></h2><p>We’re a student-led web studio. Our projects help fund Baywatch Robotics and hands-on STEM education. You work directly with the people building your site.</p><a href="https://frc7790.com" target="_blank" rel="noreferrer">Meet the robotics team <Icon name="arrowUpRight" /></a></div>
          <div class="studio-details"><div class="studio-services"><h3>From first sketch to next update.</h3><p>Design shaped around your content. Custom websites and web applications. Maintenance after launch. You own the code.</p></div><div class="people"><div><h3>Ryan Latimer</h3><p>Operations & development</p></div><div><h3>Gavin Moceri</h3><p>Technical direction & development</p></div><div><h3>Conner Breckenfeld</h3><p>Communications & creative</p></div></div><a href="/communications/">How we work <Icon name="arrowUpRight" /></a></div>
        </section>

        <section class="canvas-view contact-view" data-panel="contact" hidden aria-labelledby="contact-title">
          <div class="contact-heading"><h2 id="contact-title">Have something<br /><span>in mind?</span></h2><p>Tell us what you’re making. We’ll talk through the scope, timeline, and cost before development starts.</p><a href="mailto:contact@avexel.co">contact@avexel.co <Icon name="arrowUpRight" /></a><a href="tel:+12313738360">(231) 373-8360</a></div>
          <form class="scene-form" action="https://formspree.io/f/xvgkwonw" method="POST" data-contact-form><div class="form-pair"><div class="field"><label for="contact-name">Your name</label><input id="contact-name" name="name" autocomplete="name" required maxlength="120" /></div><div class="field"><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div></div><div class="field"><label for="contact-service">What can we help with?</label><select id="contact-service" name="service"><option>New website</option><option>Web application</option><option>Website redesign</option><option>Maintenance & updates</option><option>Something else</option></select></div><div class="field"><label for="contact-message">A little about your project</label><textarea id="contact-message" name="message" rows="3" required maxlength="10000"></textarea></div><div class="honeypot" aria-hidden="true"><label for="website-field">Leave this empty</label><input id="website-field" name="_gotcha" tabindex="-1" autocomplete="off" /></div><input type="hidden" name="_subject" value="New project inquiry from Avexel" /><button type="submit" class="send-message">Send message <Icon name="arrowUpRight" /></button><p class="form-status" role="status" aria-live="polite" tabindex="-1"></p></form>
        </section>

        <footer class="real-footer"><span>Supporting Baywatch Robotics.</span><button type="button" data-replay>Replay the teardown <span>↺</span></button><span>© {new Date().getFullYear()} Avexel</span></footer>
      </div>
      <div class="story-controls"><span class="story-chapter">THE DEFAULT</span><div class="story-track"><span></span></div><button type="button" data-skip>Skip to the good part <span>↗</span></button></div>
    </div>
  </div>
  <noscript><style>.scroll-story{height:auto}.scene{position:relative;height:auto;overflow:visible}.demo-page,.intervention,.annotations,.eraser-canvas,.story-controls{display:none}.real-site{position:relative;clip-path:none!important;min-height:100svh}.real-site [inert]{pointer-events:auto}</style><p class="no-script-message">Please enable JavaScript to explore the animated introduction and studio views. Contact us at <a href="mailto:contact@avexel.co">contact@avexel.co</a>.</p></noscript>
  <script>import '../scripts/scene';</script>
</SiteLayout>
