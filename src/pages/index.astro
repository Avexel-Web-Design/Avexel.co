---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import FinalStudio from '../components/FinalStudio.astro';
import '../styles/scene.css';
import '../styles/studio.css';
import '../styles/services.css';
import '../styles/motion.css';

const projects = [
  { name: 'Atlas', type: 'Robotics intelligence', image: 'atlas', url: 'https://atlas.frc7790.com', description: 'Competition data, predictions, and scouting. One place for the decisions that happen before the match.' },
  { name: 'Afterimage', type: 'Multiplayer browser game', image: 'afterimage', url: 'https://afterimage.avexel.workers.dev', description: 'Your past movements become your next opponent. A multiplayer game built to play in your browser.' },
  { name: 'Baywatch Robotics', type: 'Team website', image: 'baywatch', url: 'https://frc7790.com', description: 'A home for the robots, people, and sponsors behind FIRST Robotics Team 7790.' },
  { name: 'Detroit Rising', type: 'Real estate development', image: 'detroit', url: 'https://detroitrisingdevelopment.pages.dev', description: 'A clear view of a development company’s projects, services, and vision for Detroit.' },
];
const annotations = [
  { id: 'brand', target: '.demo-brand > span', text: 'Yet another pointless dot.' },
  { id: 'nav', target: '.demo-nav > div', text: 'The same menu as everyone' },
  { id: 'label', target: '.demo-eyebrow', text: 'Buzzwords with the little circle' },
  { id: 'description', target: '.demo-description', text: '15 words. Still no idea what you get.' },
  { id: 'button', target: '.demo-copy > .demo-cta', text: 'What exactly does this button do?' },
  { id: 'art', target: '.plus-one', text: 'Why is there a plus sign?' },
  { id: 'artsecond', target: '.plus-two', text: 'Oh look, another plus sign' },
  { id: 'caption', target: '.demo-art figcaption', text: 'More extra words that mean nothing' },
  { id: 'craft', target: '.art-caption', text: 'Even more vague words' },
  { id: 'bottom', target: '.demo-bottom > span:first-child', text: 'Filler, but uppercase' },
  { id: 'creativity', target: '.demo-bottom > span:nth-child(2)', text: 'How many vague phrases is this?' },
  { id: 'scroll', target: '.demo-bottom > span:last-child', text: 'Unnecessary instructions' },
  { id: 'navcta', target: '.demo-nav > .demo-cta', text: 'Another slogan for the same thing' },
  { id: 'period', target: '.demo-title-period', text: 'Why the hard stop?' },
  { id: 'color', target: '.demo-title-experiences', text: 'This color really clashes with the background' },
];
---

<SiteLayout immersive title="Avexel | Our work isn't AI slop.">
  <div class="scroll-story" id="home">
    <div class="scene">
      <div class="demo-page" aria-label="An intentionally generic website, used as a design demonstration">
        <header class="demo-nav"><a class="demo-brand" href="#home">avexel<span>.</span></a><div><span>Solutions</span><span>Our process</span><span>Why us</span></div><button type="button" class="demo-cta" data-skip>Let’s innovate <Icon name="arrowUpRight" /></button></header>
        <div class="demo-main">
          <div class="demo-copy"><p class="demo-eyebrow"><i></i> YOUR VISION. OUR INNOVATION.</p><h1>We build digital<br /><span><span class="demo-title-experiences">experiences</span><span class="demo-title-period">.</span></span></h1><p class="demo-description">Empowering ambitious brands with cutting-edge solutions that elevate your digital presence and unlock limitless possibilities.</p><button class="demo-cta" type="button" data-skip>Unlock your potential <Icon name="arrowUpRight" /></button></div>
          <figure class="demo-art"><img src="/images/work-atlas.webp?v=13cdd7d" alt="Atlas web application" width="1440" height="1000" fetchpriority="high" /><span class="art-plus plus-one">+</span><span class="art-plus plus-two">+</span><figcaption>DIGITAL EXCELLENCE / REIMAGINED</figcaption><span class="art-caption">CRAFTED WITH PURPOSE</span></figure>
        </div>
        <div class="demo-bottom"><span><i></i> DESIGN-DRIVEN. FUTURE-READY.</span><span>CREATIVITY MEETS TECHNOLOGY</span><span>SCROLL TO DISCOVER ↓</span></div>
      </div>

      <div class="intervention" aria-hidden="true">
        <div class="statement line-one"><span class="keep-work word-space-after">Our work</span><span class="discard-one">does</span><span class="keep-not">n’t</span><span class="discard-one word-space-before">look like this.</span></div>
        <div class="statement line-two"><span class="discard-two word-space-after">This</span><span class="keep-is word-space-after">is</span><span class="keep-slop">AI slop.</span></div>
      </div>

      <div class="annotations" aria-hidden="true">
        {annotations.map(note => <div class={`annotation note-${note.id}`} data-note={note.id} data-target={note.target}><span>{note.text}</span></div>)}
      </div>

      <canvas class="eraser-canvas" aria-hidden="true"></canvas>

      <FinalStudio projects={projects} />
    </div>
  </div>
  <noscript><style>.scroll-story{height:auto}.scene{position:relative;height:auto;overflow:visible}.demo-page,.intervention,.annotations,.eraser-canvas{display:none}.real-site{position:relative;mask-image:none!important;-webkit-mask-image:none!important;min-height:100svh}.real-site [inert]{pointer-events:auto}</style><p class="no-script-message">Please enable JavaScript to explore the animated introduction and team views. Contact us at <a href="mailto:contact@avexel.co">contact@avexel.co</a>.</p></noscript>
  <script>import '../scripts/scene';</script>
</SiteLayout>
