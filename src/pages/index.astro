---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';

const projects = [
  {
    name: 'Baywatch Robotics',
    image: 'baywatch',
    url: 'https://frc7790.com',
    description: 'Team information, robot designs, competition history, and sponsorship resources for FRC Team 7790.',
  },
  {
    name: 'Detroit Rising Development',
    image: 'detroit',
    url: 'https://detroitrisingdevelopment.pages.dev',
    description: 'A company website presenting real estate development projects and services.',
  },
  {
    name: 'Afterimage',
    image: 'afterimage',
    url: 'https://afterimage.avexel.workers.dev',
    description: 'A multiplayer browser game where recorded movements return as opponents. Includes solo practice and spectator mode.',
  },
  {
    name: 'Atlas',
    image: 'atlas',
    url: 'https://atlas.frc7790.com',
    description: 'FRC team statistics, event results, match predictions, and scouting tools in one application.',
  },
];

const services = [
  { name: 'Website design', text: 'Page layouts, navigation, and visual design based on your content and audience. We share designs for your feedback before development.' },
  { name: 'Web development', text: 'Custom websites and applications, including forms, booking systems, online stores, and integrations. Built for phones, tablets, and desktops.' },
  { name: 'Maintenance', text: 'Content updates, bug fixes, and new features for existing websites. We agree on the work and cost before making changes.' },
];
---

<SiteLayout>
  <section id="home" class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Custom websites.<br /><span>Web applications.</span></h1>
      <p>We design, build, and maintain websites for businesses and nonprofits in Northern Michigan and beyond.</p>
      <div class="hero-actions">
        <a class="button" href="#contact">Start a project <Icon name="arrowUpRight" /></a>
        <a class="text-link" href="#work">Our work <Icon name="arrowRight" /></a>
      </div>
    </div>
    <figure class="hero-visual">
      <a class="hero-project glass" href="https://atlas.frc7790.com" target="_blank" rel="noreferrer" aria-label="Open Atlas, our FRC data and scouting application">
        <img src="/images/work-atlas.webp" srcset="/images/work-atlas-400.webp 400w, /images/work-atlas-800.webp 800w, /images/work-atlas.webp 1440w" sizes="(max-width: 767px) 90vw, 55vw" alt="Atlas showing team ratings, current events, and team search" width="1440" height="1000" fetchpriority="high" />
      </a>
      <figcaption><a href="https://atlas.frc7790.com" target="_blank" rel="noreferrer">Atlas <Icon name="arrowUpRight" /></a><span>FRC data & scouting</span></figcaption>
    </figure>
  </section>

  <section id="work" class="section work-section wrap" aria-labelledby="work-title">
    <h2 id="work-title">Our work</h2>
    <div class="projects-grid">
      {projects.map(project => (
        <article class="project">
          <a class="project-image glass" href={project.url} target="_blank" rel="noreferrer" aria-label={`Open ${project.name}`}>
            <img src={`/images/work-${project.image}.webp`} srcset={`/images/work-${project.image}-400.webp 400w, /images/work-${project.image}-800.webp 800w, /images/work-${project.image}.webp ${project.image === 'atlas' || project.image === 'afterimage' ? 1440 : 1200}w`} sizes="(max-width: 767px) 90vw, 45vw" alt={`${project.name} website`} width="1440" height="1000" loading="lazy" decoding="async" />
          </a>
          <h3><a href={project.url} target="_blank" rel="noreferrer">{project.name} <Icon name="arrowUpRight" /></a></h3>
          <p>{project.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="services" class="section services-section wrap" aria-labelledby="services-title">
    <h2 id="services-title">Services</h2>
    <div class="services-list">
      {services.map(service => <article class="service-row"><h3>{service.name}</h3><p>{service.text}</p></article>)}
    </div>
  </section>

  <section id="about" class="section about-section wrap" aria-labelledby="about-title">
    <div class="about-copy">
      <h2 id="about-title">About Avexel</h2>
      <p>We’re a student-led web development team based in Harbor Springs, Michigan. We started Avexel to help fund our FIRST® Robotics team, Baywatch Robotics.</p>
      <p>Our projects support the team’s robotics activities and hands-on STEM education. Clients work directly with the developers building their website.</p>
      <a class="text-link" href="https://frc7790.com" target="_blank" rel="noreferrer">Baywatch Robotics <Icon name="arrowUpRight" /></a>
    </div>
    <div class="team-list" aria-label="Avexel team">
      <div><h3>Ryan Latimer</h3><p>Operations & development</p></div>
      <div><h3>Gavin Moceri</h3><p>Technical direction & development</p></div>
      <div><h3>Conner Breckenfeld</h3><p>Communications & creative</p></div>
    </div>
  </section>

  <section class="section faq-section wrap" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions</h2>
    <div class="faq-list">
      <details><summary>What does a website cost?<Icon name="plus" /></summary><p>Pricing depends on the pages, features, and integrations. Tell us what you need and we’ll provide a quote before development begins. Domain registration, hosting, and third-party services are priced separately.</p></details>
      <details><summary>Will I own my website?<Icon name="plus" /></summary><p>Yes. You own the code and content, and can choose where to host it and who maintains it.</p></details>
      <details><summary>Can you work on my existing site?<Icon name="plus" /></summary><p>Send us the URL and describe the changes you need. We’ll review the site and discuss whether to update it or rebuild it.</p></details>
      <details><summary>What happens after launch?<Icon name="plus" /></summary><p>We can handle content updates, maintenance, and additional features. We agree on support arrangements and costs as part of your project.</p></details>
    </div>
  </section>

  <section id="contact" class="section contact-section wrap" aria-labelledby="contact-title">
    <div class="contact-copy">
      <h2 id="contact-title">Tell us about<br />your project.</h2>
      <p>Describe what you need, any required features, and your timeline. If you have an existing site, include the URL.</p>
      <a class="contact-email" href="mailto:contact@avexel.co">contact@avexel.co <Icon name="arrowUpRight" /></a>
      <a class="contact-phone" href="tel:+12313738360">(231) 373-8360</a>
    </div>
    <form class="contact-form glass" action="https://formspree.io/f/xvgkwonw" method="POST" data-contact-form>
      <div class="form-pair">
        <div class="field"><label for="contact-name">Your name</label><input id="contact-name" name="name" autocomplete="name" required maxlength="120" /></div>
        <div class="field"><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div>
      </div>
      <div class="field"><label for="contact-service">What can we help with?</label><select id="contact-service" name="service"><option>New website</option><option>Web application</option><option>Website redesign</option><option>Maintenance & updates</option><option>Something else</option></select></div>
      <div class="field"><label for="contact-message">Project details</label><textarea id="contact-message" name="message" rows="4" required maxlength="10000"></textarea></div>
      <div class="honeypot" aria-hidden="true"><label for="website-field">Leave this empty</label><input id="website-field" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
      <input type="hidden" name="_subject" value="New project inquiry from Avexel" />
      <button class="button" type="submit">Send message <Icon name="arrowUpRight" /></button>
      <p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
    </form>
  </section>
</SiteLayout>
